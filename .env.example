# PayPilot AI — environment template.
# Copy to .env and fill in real values. NEVER commit .env.

# --- Database (docker-compose + backend) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=paypilot
DB_USER=paypilot
DB_PASSWORD=paypilot
DB_POOL_SIZE=10

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Backend ---
SERVER_PORT=8080
HEALTH_SHOW_DETAILS=always

# --- LLM providers (Phase 10+) ---
# OpenRouter (OpenAI-compatible endpoint)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Razorpay (Phase 8+, test keys from dashboard) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
