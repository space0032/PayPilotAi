# PayPilot AI — environment template.
# Copy to .env and fill in real values. NEVER commit .env.

# --- Database (docker-compose + backend) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=paypilot
DB_USER=paypilot
DB_PASSWORD=paypilot
DB_POOL_SIZE=10

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Backend ---
SERVER_PORT=8080
HEALTH_SHOW_DETAILS=always
# Signing key for JWTs. Generate once, keep stable across restarts:
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
#   or: openssl rand -base64 48
JWT_SECRET=

# --- LLM providers (agent planner; set AGENT_LLM_PROVIDER=openai-compatible) ---
# The backend reads paypilot.agent.llm.* which fall back to these vars:
#   base-url <- OPENROUTER_BASE_URL -> OLLAMA_BASE_URL
#   api-key  <- OPENROUTER_API_KEY  (Ollama needs none)
#   model    <- OPENROUTER_MODEL    -> OLLAMA_MODEL
# Explicit AGENT_LLM_* overrides always win.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Agent guardrails ---
AGENT_MAX_SPEND_PAISE=1000000        # per-purchase cap (paise)
AGENT_DAILY_SPEND_CAP_PAISE=2000000  # rolling-24h cap across sessions
AGENT_CONSENT_TTL_MINUTES=30         # unanswered consent asks expire

# --- Razorpay (Phase 8+, test keys from dashboard) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
