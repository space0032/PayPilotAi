<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Human-readable console output for local development.
         Structured JSON logging arrives in Phase 15 (observability);
         the MDC keys used here stay identical when we switch encoders. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [req=%X{requestId:-}] %logger{40} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="com.paypilot" level="DEBUG"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
</configuration>
